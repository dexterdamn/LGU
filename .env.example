# Database (Neon, Vercel Postgres, or local PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/gadfs?schema=public"

# JWT secret (generate with: openssl rand -base64 32)
JWT_SECRET="your-super-secret-jwt-key-change-in-production"

# SMTP for email OTP (Gmail example)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="GADFS Data Entry <your-email@gmail.com>"

# App URL (for TOTP QR code label)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# TOTP issuer name shown in Google Authenticator
TOTP_ISSUER="GADFS Data Entry"
